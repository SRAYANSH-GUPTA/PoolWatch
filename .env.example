# Runtime mode:
# - passive: collect metrics only
# - assisted: passive collection plus alerting/analysis
# - proxy: start with guarded proxy mode enabled
POOLWATCH_MODE=passive

# HTTP API bind address.
POOLWATCH_HTTP_ADDR=:8080

# Guarded proxy listen address.
POOLWATCH_PROXY_LISTEN_ADDR=:6433

# Upstream target for proxy mode, usually pgBouncer.
POOLWATCH_PROXY_UPSTREAM_ADDR=127.0.0.1:6432

# PostgreSQL DSN used for pool and query observability.
POOLWATCH_POSTGRES_DSN=postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable

# pgBouncer DSN used for SHOW POOLS / SHOW STATS collection.
POOLWATCH_PGBOUNCER_DSN=postgres://postgres:postgres@pgbouncer:6432/pgbouncer?sslmode=disable

# Optional MongoDB URI. Leave empty to keep history in memory only.
POOLWATCH_MONGODB_URI=

# MongoDB database and collections for persisted snapshots and alerts.
POOLWATCH_MONGODB_DATABASE=poolwatch
POOLWATCH_MONGODB_SNAPSHOTS_COLLECTION=snapshots
POOLWATCH_MONGODB_ALERTS_COLLECTION=alerts

# TTL retention for MongoDB history.
POOLWATCH_MONGODB_RETENTION=168h

# How often collectors sample PostgreSQL and pgBouncer.
POOLWATCH_COLLECT_INTERVAL=2s

# Reserved analysis interval config. Current analyzer is event-driven.
POOLWATCH_ANALYZE_INTERVAL=5s

# Internal event queue size between collector, analyzer, and proxy signals.
POOLWATCH_EVENT_QUEUE_SIZE=2048

# Number of recent snapshots and alerts kept in memory.
POOLWATCH_HISTORY_LIMIT=180

# Alert threshold: warn when derived pool usage reaches 85%.
POOLWATCH_POOL_USAGE_THRESHOLD=0.85

# Alert threshold: warn when p95 wait time crosses this duration.
POOLWATCH_WAIT_P95_THRESHOLD=250ms

# Alert threshold: flag long-running active queries above this duration.
POOLWATCH_LONG_QUERY_THRESHOLD=5s

# Alert threshold: flag idle or idle-in-transaction connections above this duration.
POOLWATCH_LEAK_THRESHOLD=30s

# Proxy safety guard: disable proxy if p95 session latency exceeds this limit.
POOLWATCH_PROXY_LATENCY_LIMIT=1ms

# Proxy safety guard: disable proxy if internal queue depth exceeds this limit.
POOLWATCH_PROXY_QUEUE_LIMIT=4096

# Proxy safety guard: maximum concurrent proxied connections.
POOLWATCH_PROXY_CONNECTION_LIMIT=10000

# JSON log verbosity: debug, info, warn, or error.
POOLWATCH_LOG_LEVEL=info
